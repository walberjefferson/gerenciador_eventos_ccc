APP_NAME="Gestao de Eventos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL fornecido pelo Laravel Sail (servico "pgsql" no docker-compose.yml).
# Rodando o PHP no host: DB_HOST=127.0.0.1
# Rodando o PHP dentro do container do Sail: DB_HOST=pgsql e DB_PORT=5432
#
# A porta 5432 do computador costuma ja estar ocupada por outro PostgreSQL
# instalado diretamente na maquina. Para evitar esse choque, o banco do Sail
# e publicado na porta 55432 (veja FORWARD_PGSQL_PORT no fim do arquivo).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=gestao_eventos
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# A fila. Todo e-mail do participante sai por aqui, e nao durante o pedido
# dele. ATENCAO: fila so anda com um trabalhador de pe. Sem ele, nenhum e-mail
# sai. O comando esta em docs/ARCHITECTURE.md, secao "Trabalho em segundo
# plano":  php artisan queue:work redis --queue=emails
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit, fornecido pelo Sail: em desenvolvimento, todo e-mail enviado para no
# painel em http://localhost:8025, e nao na caixa de entrada de ninguem.
# O remetente vale para todas as mensagens e nunca aparece no codigo.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="eventos@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Pagamentos ---------------------------------------------------------
# Provedor ativo. "fake" e o provedor simulado, para desenvolvimento e teste.
# "efi" cobra de verdade pela API Pix da Efi — exige TODAS as variaveis
# EFI_* abaixo preenchidas, senao o provedor recusa operar.
PAYMENT_GATEWAY=fake
# Endpoints de simulacao do provedor falso. So funcionam em local/testing.
PAYMENT_FAKE_SIMULATION_ENABLED=true
PAYMENT_FAKE_WEBHOOK_SECRET=segredo-de-teste-do-provedor-simulado

# --- Efi (provedor real de Pix) -----------------------------------------
# Preencher SO quando PAYMENT_GATEWAY=efi. Cada ambiente da Efi tem o seu
# proprio par de credenciais e o seu proprio certificado: nao misturar.
# "homologacao" nao move dinheiro; "producao" move.
EFI_ENVIRONMENT=homologacao
# Credenciais da aplicacao, criadas no painel da Efi.
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
# Caminho absoluto do certificado .pem, convertido do .p12 do painel com
# "openssl pkcs12 -in certificado.p12 -out certificado.pem -nodes".
# O arquivo NUNCA entra no repositorio.
EFI_CERT_PATH=
# Chave Pix da conta que RECEBE o dinheiro (a do evento), nunca a de quem paga.
EFI_PIX_KEY=
# Valor conferido no parametro "hmac" da URL registrada como webhook na Efi.
# Sem ele, todo aviso e recusado — a falha e sempre para o lado seguro.
EFI_WEBHOOK_HMAC=
# Segundos de espera por resposta da Efi.
EFI_TIMEOUT=20

# Segredo usado para gerar a impressao digital do CPF (deduplicacao).
# Trocar este valor invalida a comparacao de duplicidade dos registros existentes.
DOCUMENTO_HASH_PEPPER=troque-este-valor-em-producao

# --- Comunicacao com o participante -------------------------------------
# A fila onde os e-mails esperam. Separada da padrao para que um trabalhador
# dedicado a e-mail nao dispute vez com outro tipo de tarefa.
COMUNICACAO_FILA=emails
# Conexao de fila usada so pelos e-mails. Vazio = usa QUEUE_CONNECTION.
COMUNICACAO_CONEXAO_FILA=
# Quantas vezes insistir quando o servidor de e-mail nao responde. Esgotadas as
# tentativas, o trabalho vai para a tabela "failed_jobs" e nada acontece com a
# inscricao, a vaga ou o pagamento.
COMUNICACAO_TENTATIVAS=3
# Lembrete de prazo: com quantas horas de antecedencia o aviso sai, e quantas
# inscricoes sao lidas por vez na varredura.
INSCRICOES_LEMBRETE_JANELA_HORAS=24
INSCRICOES_LEMBRETE_LOTE=100

# --- Sail ---------------------------------------------------------------
# Porta do computador que da acesso ao PostgreSQL do Sail. Precisa ser a mesma
# de DB_PORT quando o PHP roda no host.
# Porta em que o site responde na maquina quando o Sail sobe a aplicacao.
APP_PORT=80
VITE_PORT=5173
FORWARD_PGSQL_PORT=55432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
