APP_NAME="Gestao de Eventos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL fornecido pelo Laravel Sail (servico "pgsql" no docker-compose.yml).
# Rodando o PHP no host: DB_HOST=127.0.0.1
# Rodando o PHP dentro do container do Sail: DB_HOST=pgsql e DB_PORT=5432
#
# A porta 5432 do computador costuma ja estar ocupada por outro PostgreSQL
# instalado diretamente na maquina. Para evitar esse choque, o banco do Sail
# e publicado na porta 55432 (veja FORWARD_PGSQL_PORT no fim do arquivo).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=gestao_eventos
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit, fornecido pelo Sail. Nenhum e-mail e enviado nesta fase do projeto.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="eventos@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Pagamentos ---------------------------------------------------------
# Provedor ativo. "fake" e o provedor simulado, para desenvolvimento e teste.
PAYMENT_GATEWAY=fake
# Endpoints de simulacao do provedor falso. So funcionam em local/testing.
PAYMENT_FAKE_SIMULATION_ENABLED=true
PAYMENT_FAKE_WEBHOOK_SECRET=segredo-de-teste-do-provedor-simulado
# Segredo usado para gerar a impressao digital do CPF (deduplicacao).
# Trocar este valor invalida a comparacao de duplicidade dos registros existentes.
DOCUMENTO_HASH_PEPPER=troque-este-valor-em-producao

# --- Sail ---------------------------------------------------------------
# Porta do computador que da acesso ao PostgreSQL do Sail. Precisa ser a mesma
# de DB_PORT quando o PHP roda no host.
FORWARD_PGSQL_PORT=55432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
