# ===========================================================================
# Variáveis do stack de produção — Gestão de Eventos (CCC)
#
# Este arquivo é um MODELO. Ele existe para ser copiado para a aba
# "Environment variables" do stack no Portainer e preenchido lá.
#
# NENHUM valor real entra aqui. Nada neste arquivo é segredo, e nada neste
# arquivo deve virar segredo: ele está no repositório, e o repositório é lido
# por gente que não precisa saber a senha do banco do evento.
#
# O roteiro completo — publicar a imagem, criar o stack, criar o primeiro
# administrador, cadastrar a credencial da Efí e registrar o aviso — está em
# docs/DEPLOY.md. Este arquivo é só a lista de variáveis.
# ===========================================================================

# --- Imagem ----------------------------------------------------------------
# A tag publicada no GHCR pelo workflow .github/workflows/docker-publish.yml.
# Um push na "main" reescreve :latest.
APP_IMAGE=ghcr.io/walberjefferson/gerenciador_eventos_ccc:latest

# --- Aplicação -------------------------------------------------------------
APP_NAME=Gestão de Eventos

# Gere UMA vez e guarde. Trocar esta chave depois do sistema em uso torna
# ilegível tudo o que está cifrado no banco: o CPF de cada inscrição (D-08) e a
# credencial da Efí (DA-25). Não há como desfazer.
#   php artisan key:generate --show
#   ou: echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Fuso da aplicação. O banco guarda em UTC e a aplicação converte (D-10).
# Errar aqui desloca o prazo de pagamento em três horas — e vaga perdida por
# causa disso não volta.
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# Quanto o log guarda. "warning" em produção; "debug" só enquanto se investiga
# alguma coisa, e voltando depois.
LOG_LEVEL=warning

# APP_ENV e APP_DEBUG NÃO são variáveis do stack — vão fixos como "production"
# e "false" dentro do docker/compose.portainer.yaml, de propósito. Com
# APP_DEBUG=true qualquer erro devolveria ao visitante a pilha de chamadas, os
# caminhos do servidor e as variáveis de ambiente da requisição, incluindo a
# chave da Resend. Isso não pode depender de ninguém digitar certo num
# formulário.

# --- Domínio e Traefik -----------------------------------------------------
# O domínio da aplicação. APP_URL e ASSET_URL são montadas a partir dele, em
# https, dentro do compose.
APP_DOMAIN=inscricoes.cccista.com.br

# A rede externa onde o Traefik deste servidor vive. Confira com:
#   docker network ls
TRAEFIK_NETWORK=proxy

# O nome do resolvedor de certificado (Let's Encrypt) configurado no Traefik.
# Confira com:
#   docker inspect $(docker ps -qf name=traefik) | grep -i certificatesresolvers
TRAEFIK_CERTRESOLVER=le

# O endereço público de onde a Efí envia o aviso de pagamento. Só ele passa
# pelo router do webhook (decisão DA-28). Mude apenas se a Efí anunciar
# endereço novo — e, se mudar, o aviso para de chegar até corrigir aqui.
EFI_IP_PERMITIDO=34.193.116.226/32

# --- Banco de dados (PostgreSQL dentro do próprio stack) -------------------
# Nenhuma porta é publicada no host: o banco só existe na rede interna.
DB_DATABASE=gestao_eventos
DB_USERNAME=eventos
# Senha forte, gerada e guardada no gerenciador de senhas:
#   openssl rand -hex 24
DB_PASSWORD=

# --- E-mail (Resend — decisão DA-29) ---------------------------------------
# A chave da API, criada em https://resend.com/api-keys.
# O domínio de MAIL_FROM_ADDRESS precisa estar verificado na Resend, senão a
# entrega é recusada e o trabalho volta para a fila até falhar três vezes.
RESEND_API_KEY=
MAIL_FROM_ADDRESS=eventos@cccista.com.br
MAIL_FROM_NAME=Inscrições CCC

# --- Impressão digital do CPF ----------------------------------------------
# Segredo que tempera o hash usado para detectar inscrição duplicada (D-08).
# Definido UMA vez, na criação do stack, e NUNCA mais alterado: trocar este
# valor faz o sistema deixar de reconhecer como duplicadas as inscrições já
# gravadas — a mesma pessoa passaria a conseguir se inscrever duas vezes.
#   openssl rand -hex 32
DOCUMENTO_HASH_PEPPER=

# --- Pagamentos ------------------------------------------------------------
# Qual provedor cobra. "efi" é o real; "fake" é o simulado, que o compose já
# impede de emitir cobrança fictícia em produção.
PAYMENT_GATEWAY=efi

# As credenciais da Efí NÃO entram aqui. Desde a fase 8b elas moram cifradas no
# banco e são cadastradas na tela "Credenciais de pagamento" do painel
# (decisões DA-25 e DA-26), com homologação e produção separadas. As variáveis
# EFI_* continuam existindo no código apenas como reserva, e ficam vazias.
# Ver a seção 7 de docs/DEPLOY.md.
